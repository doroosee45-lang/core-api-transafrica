# Trans Afrique Core API — variables serveur (JAMAIS dans un frontend ni dans Git)
NODE_ENV=development
PORT=5100
TRUST_PROXY=false

# Connexion PostgreSQL du projet Supabase (Settings > Database). SSL obligatoire en production.
DATABASE_URL=postgres://postgres:<mot-de-passe>@db.<projet>.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Supabase Auth
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_ANON_KEY=
# Uniquement pour la reprise des comptes (admin.createUser). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=
# Projets « legacy » HS256 uniquement ; sinon laisser vide (vérification par JWKS).
SUPABASE_JWT_SECRET=
AUTH_ENFORCE_MFA=true
# Verrouillage temporaire d'un compte après N échecs de connexion (D-18, valeurs à confirmer)
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15

CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# E-mail (Resend). Vide => livraisons « skipped », jamais déclarées envoyées.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Secret « whsec_… » du webhook Resend (statut réel de délivrance, rebonds, plaintes)
RESEND_WEBHOOK_SECRET=

# Documents : bucket PRIVÉ Supabase Storage (à créer), taille maximale par fichier
STORAGE_BUCKET=canada-documents
DOCUMENT_MAX_BYTES=10485760

OUTBOX_POLL_MS=2000
WORKER_ENABLED=true

# Reprise des données de l'ancien backend (lecture seule)
LEGACY_MONGO_URI=
